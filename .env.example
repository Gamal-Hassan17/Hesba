# Required in production: generate a long random value
SECRET_KEY=replace-with-a-long-random-secret

# Local development defaults to SQLite. On Render, paste the Supabase/Render PostgreSQL URI.
DATABASE_URL=

# Supabase Storage (create a PRIVATE bucket named receipts)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_BUCKET=receipts

# Enable secure session cookies when deployed behind HTTPS
COOKIE_SECURE=0
FLASK_DEBUG=1
